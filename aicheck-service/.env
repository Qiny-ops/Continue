# ==================== 服务基础 ====================
APP_NAME=AI Code Check Service
APP_VERSION=1.0.0
DEBUG=false

# ==================== 安全 ====================
# Django 侧调用本服务时携带 X-API-Key；空=开发模式放行
API_KEY=
# Django 内部接口鉴权（仅微服务调 Django 用例接口时使用）
INTERNAL_API_KEY=

# ==================== 服务端口/并发 ====================
HOST=0.0.0.0
PORT=8004
CONCURRENCY=3
MAX_RETRIES=3
TIMEOUT=300
# 课程要求：并发请求间最小间隔（秒）
REQUEST_INTERVAL=1.0

# ==================== 文件路径 ====================
WORKSPACES_DIR=./workspaces
TEST_CASES_DIR=./test_cases
DATA_DIR=./data
# 多值：JSON 数组字符串
ALLOWED_ROOT_PATHS=[]

# ==================== CORS ====================
# JSON 数组字符串
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# ==================== Webhook ====================
# 全局监听分支（逗号分隔；空表示仅依赖 WEBHOOK_REPOS 逐仓配置）
WATCH_BRANCHES=develop,main
# JSON 字符串：{repo_full_name: {branches, case_source, project_code, gate:{provider,token}}}
# 示例：
# WEBHOOK_REPOS={"owner/frontend": {"branches": ["develop"], "case_source": "platform", "project_code": "demo-fe", "gate": {"provider": "github", "token": ""}}, "owner/backend": {"branches": ["develop"], "case_source": "platform", "project_code": "demo-be", "gate": {"provider": "github"}}}
WEBHOOK_REPOS=

GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_TOKEN=

# ==================== Git 平台 Commit Status ====================
# 全局 status token（单仓配置 token 覆盖）
GITHUB_STATUS_TOKEN=
GITLAB_STATUS_TOKEN=
GITLAB_BASE_URL=https://gitlab.com

# ==================== 平台（Django） ====================
# 微服务回调 Django 内部接口的基地址
DJANGO_BASE_URL=http://localhost:8000
# 前端报告页基地址（用于 Commit Status target_url）
FRONTEND_REPORT_BASE_URL=http://localhost:5173

# ==================== 风险策略 ====================
# 风险等级 ≥ 该值直接阻断；可选 高/中/低
RISK_BLOCK_LEVEL=高
