# ============================================================
# Django 后端环境变量示例
# 复制为 .env 并填入真实值；生产环境务必修改所有密钥类字段
# ============================================================

# ---- 基础 ----
DJANGO_DEBUG=false
# 生产必须设置强随机 SECRET_KEY（不要使用默认值）
DJANGO_SECRET_KEY=change-me-to-a-strong-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- JWT ----
# 必须与 SECRET_KEY 不同！未设置会回退到 SECRET_KEY（不安全，仅开发）
JWT_SECRET=change-me-to-another-strong-random-string
JWT_EXPIRATION_HOURS=24

# ---- 凭据字段对称加密密钥（Fernet）----
# 生产必须执行：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生成独立密钥填入；未设置会由 SECRET_KEY 派生（仅开发可用，密钥轮换将不可解密历史数据）
DB_FIELD_ENCRYPTION_KEY=

# ---- 前端 ----
FRONTEND_URL=http://localhost:5173

# ---- CORS 白名单（逗号分隔，对应 corsheaders）----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- 知识库（WeKnora）----
WEKNORA_BASE_URL=http://127.0.0.1:3000/api/v1
WEKNORA_API_KEY=your_weknora_api_key
WEKNORA_DEFAULT_EMBEDDING_MODEL_ID=
WEKNORA_DEFAULT_LLM_MODEL_ID=
WEKNORA_AGENT_TIMEOUT=120
WEKNORA_DEFAULT_AGENT_ID=builtin-smart-reasoning

# ---- AI 生成微服务 ----
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=600
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600
AI_CLIENT_THREAD_POOL_SIZE=10

# ---- 接口测试微服务 ----
API_TESTING_SERVICE_URL=http://localhost:8002
API_TESTING_SERVICE_TIMEOUT=120
# 调用 api-testing 时携带的 API Key（需与 api-testing 服务侧 API_KEY 配置一致）
API_TESTING_API_KEY=

# ---- Web 自动化微服务 ----
WEB_AUTOMATION_SERVICE_URL=http://localhost:8003
WEB_AUTOMATION_SERVICE_TIMEOUT=180
# 调用 web-automation 时携带的 API Key（需与 web-automation 服务侧 API_KEY 配置一致）
WEB_AUTOMATION_API_KEY=

# ---- 内部服务间调用 Key（Django 侧；需与 api-testing 侧 INTERNAL_API_KEY 一致）----
INTERNAL_API_KEY=

# ---- 用例去重（OpenAI 兼容 Embedding）----
OPENAI_API_KEY=your_openai_compatible_key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_EMBEDDING_MODEL=embedding-3
OPENAI_EMBEDDING_TIMEOUT=30

# ---- 请求体大小上限（字节）----
MAX_REQUEST_BODY_SIZE=10485760

# ---- 邮件（可选）----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ---- 数据库（默认 SQLite；如需 PostgreSQL 取消注释并配置）----
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=testdb
# DB_USER=dbuser
# DB_PASSWORD=dbpass
# DB_HOST=localhost
# DB_PORT=5432
