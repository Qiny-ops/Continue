# 模型 API 配置
MODEL_API_KEY=EMPTY
# 模型服务地址：通过环境变量注入，禁止在代码/配置中硬编码内网 IP
MODEL_BASE_URL=http://localhost:8000/v1

# 推理参数
MAX_TOKENS=81920
TEMPERATURE=1.0
TOP_P=0.95
PRESENCE_PENALTY=1.5
TOP_K=20

# 重试配置
MAX_RETRIES=3
RETRY_DELAY=2.0

# 服务配置
APP_NAME=AI Generator Service
APP_VERSION=1.0.0
DEBUG=false

# Redis 配置（可选）
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# ===== 安全配置（阶段0 新增）=====
# CORS 白名单（逗号分隔）；为空 = 不跨域
CORS_ALLOWED_ORIGINS=http://localhost:5173
